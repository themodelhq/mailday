// MailDay data model
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  displayName  String
  avatarUrl    String?
  role         UserRole @default(USER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  messages     Message[]
  refreshTokens RefreshToken[]
  imapAccounts ImapAccount[]
  outboundDeliveries OutboundDelivery[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Mailbox {
  INBOX
  SENT
  DRAFT
  ARCHIVE
  TRASH
  SPAM
}

enum MessageState {
  RECEIVED
  SENT
  DRAFT
  QUEUED
  FAILED
}

model Message {
  id          String        @id @default(uuid())
  ownerId     String
  owner       User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  mailbox     Mailbox       @default(INBOX)
  state       MessageState  @default(RECEIVED)
  from        String
  to          String[]
  subject     String        @default("")
  body        String        @default("")
  snippet     String        @default("")
  isRead      Boolean       @default(false)
  isStarred   Boolean       @default(false)
  isImportant Boolean       @default(false)
  labels      String[]      @default([])
  hasAttachments Boolean    @default(false)
  sentAt      DateTime      @default(now())
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([ownerId, mailbox, sentAt])
  @@index([ownerId, isRead])
  outboundDelivery OutboundDelivery?
}

model ImapAccount {
  id          String   @id @default(uuid())
  userId      String
  host        String
  port        Int      @default(993)
  username    String
  passwordEnc String
  secure      Boolean  @default(true)
  lastError   String?
  createdAt   DateTime @default(now())
  owner       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}


enum OutboundStatus {
  QUEUED
  PROCESSING
  SENT
  RETRYING
  FAILED
}

model OutboundDelivery {
  id             String         @id @default(uuid())
  ownerId         String
  owner           User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  messageId       String          @unique
  message          Message         @relation(fields: [messageId], references: [id], onDelete: Cascade)
  status          OutboundStatus  @default(QUEUED)
  attempts        Int             @default(0)
  maxAttempts     Int             @default(8)
  nextAttemptAt  DateTime         @default(now())
  lockedAt       DateTime?
  provider        String          @default("smtp")
  providerMessageId String?
  lastError      String?
  idempotencyKey String?          @unique
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  sentAt          DateTime?
  failedAt        DateTime?

  @@index([status, nextAttemptAt])
  @@index([ownerId, createdAt])
}
