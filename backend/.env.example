# Mailday backend environment
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://mailday:mailday@localhost:5432/mailday
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
VAULT_SECRET=replace-with-32-byte-or-longer-secret
FRONTEND_URL=http://localhost:3000
MAILDAY_EMAIL_DOMAIN=mailday.netlify.com # Replace with a domain configured for inbound receiving

# Outbound delivery: RESEND_API_KEY is preferred and bypasses SMTP network timeouts.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Outbound SMTP fallback
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
SMTP_CONNECTION_TIMEOUT_MS=15000
SMTP_GREETING_TIMEOUT_MS=15000
SMTP_SOCKET_TIMEOUT_MS=60000

# Inbound email webhook: generate a long random token and configure your inbound provider
INBOUND_WEBHOOK_TOKEN=
ATTACHMENTS_DIR=./uploads
# Optional ClamAV daemon for attachment scanning (leave unset = attachments marked UNCHECKED)
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=10000

# Optional integrations
ELASTICSEARCH_URL=
ZAI_API_KEY=
ZAI_MODEL=
IMAP_POLL_SECONDS=60
OUTBOUND_WORKER_ENABLED=true
OUTBOUND_WORKER_POLL_MS=5000
