# Mailday backend environment
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://mailday:mailday@localhost:5432/mailday
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
VAULT_SECRET=replace-with-32-byte-or-longer-secret
FRONTEND_URL=http://localhost:3000

# Outbound SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Inbound email webhook: generate a long random token and configure your inbound provider
INBOUND_WEBHOOK_TOKEN=
ATTACHMENTS_DIR=./uploads

# Optional integrations
ELASTICSEARCH_URL=
ZAI_API_KEY=
ZAI_MODEL=
IMAP_POLL_SECONDS=60
OUTBOUND_WORKER_ENABLED=true
OUTBOUND_WORKER_POLL_MS=5000
